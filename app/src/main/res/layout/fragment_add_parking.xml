<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAddParking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Gestione Parcheggio"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    <ScrollView
        android:id="@+id/scrollViewAddParking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Modalità parcheggio -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnSaveFavoriteOnly">

                <Button
                    android:id="@+id/btnSaveFavoriteOnly"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    app:strokeColor="@color/parking_blue_light"
                    app:backgroundTint="@color/parking_blue_dark"
                    android:text="Solo Preferito" />

                <Button
                    android:id="@+id/btnParkVehicle"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    app:strokeColor="@color/parking_blue_light"
                    app:backgroundTint="@color/parking_blue_dark"
                    android:text="Parcheggia Veicolo" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Selezione o nome posizione -->
            <TextView
                android:id="@+id/tvDisplayLocationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLocationName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    android:hint="Nome Luogo (es. Sotto casa)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSelectExistingLocation"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    app:endIconTint="@color/dynamic_border"
                    android:hint="Scegli Luogo Salvato">
                    <AutoCompleteTextView
                        android:id="@+id/actvSelectLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbSaveAsFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/sl_favorite_heart"
                    android:visibility="gone"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Geofence locale (notifiche area) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLocalGeofence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attiva Geofence (Notifiche Area)"
                app:useMaterialThemeColors="false"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>

            <!-- Tipo tariffa parcheggio -->
            <TextView
                android:id="@+id/tvDisplayParkingType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilParkingType"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxStrokeColor="@color/dynamic_border"
                android:textColorHint="@color/white"
                app:hintTextColor="@color/parking_blue_light"
                app:endIconTint="@color/dynamic_border"
                android:hint="Tipo di Tariffa">
                <AutoCompleteTextView
                    android:id="@+id/actvParkingType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Costi orari -->
            <LinearLayout
                android:id="@+id/layoutHourlyCosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    android:hint="Fisso Iniziale €">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCostInitial"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    android:hint="Costo/Ora €">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCostHourly"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    android:hint="Max €">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCostMax"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Costi fissi -->
            <LinearLayout
                android:id="@+id/layoutFixedCosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    android:hint="Costo Totale €">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFixedCost"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnFixedEndTime"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/parking_blue_light"
                    app:iconTint="@color/parking_blue_light"
                    android:text="Scadenza"
                    app:icon="@android:drawable/ic_menu_recent_history" />
            </LinearLayout>

            <!-- Selezione veicolo -->
            <TextView
                android:id="@+id/tvDisplayVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutVehicleSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSelectVehicle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/dynamic_border"
                    android:textColorHint="@color/white"
                    app:hintTextColor="@color/parking_blue_light"
                    app:endIconTint="@color/dynamic_border"
                    android:hint="Seleziona Veicolo">
                    <AutoCompleteTextView
                        android:id="@+id/actvSelectVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Mappa e strumenti -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMap"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.gms.maps.MapView
                        android:id="@+id/mapViewMini"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:id="@+id/mapTransparentOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="8dp"
                        android:gravity="end|center_vertical">

                        <TextView
                            android:id="@+id/tvSearchMap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=" Cerca via/città..."
                            android:padding="12dp"
                            android:background="#DDFFFFFF"
                            android:textColor="#333333"
                            android:visibility="gone"
                            app:drawableStartCompat="@android:drawable/ic_menu_search" />

                        <ImageButton
                            android:id="@+id/btnExpandMap"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/ic_menu_zoom"
                            android:background="#DDFFFFFF"
                            app:tint="?attr/colorPrimary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGetLocation"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:text="Posizione"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/parking_blue_dark"
                        app:iconTint="@color/white"
                        app:icon="@android:drawable/ic_menu_mylocation" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note e foto -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxStrokeColor="@color/dynamic_border"
                android:textColorHint="@color/white"
                app:hintTextColor="@color/parking_blue_light"
                android:hint="Note aggiuntive">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Gestione foto -->
            <LinearLayout
                android:id="@+id/layoutPhotoButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnViewPhoto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Mostra Foto"
                    android:visibility="gone"
                    android:textColor="@color/white"
                    app:strokeColor="@color/dynamic_border"
                    app:iconTint="@color/parking_blue_light"
                    app:icon="@android:drawable/ic_menu_gallery" />

                <Button
                    android:id="@+id/btnChangePhoto"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Aggiungi Foto"
                    android:textColor="@color/white"
                    app:strokeColor="@color/dynamic_border"
                    app:iconTint="@color/parking_blue_light"
                    app:icon="@android:drawable/ic_menu_camera" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:maxHeight="400dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:background="#00000000"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        </LinearLayout>
    </ScrollView>

    <!-- Azioni finali -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/btnDeleteLocation"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="ELIMINA"
            app:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveEverything"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:backgroundTint="@color/parking_blue_light"
            android:textColor="@color/white"
            android:text="SALVA" />
    </LinearLayout>

</LinearLayout>