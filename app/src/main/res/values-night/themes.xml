<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ParkingMate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colori primari -->
        <item name="colorPrimary">@color/parking_blue_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/parking_blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Colori secondari -->
        <item name="colorSecondary">@color/parking_blue_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/parking_blue_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Colori terziari -->
        <item name="colorTertiary">@color/parking_blue_light</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorTertiaryContainer">@color/parking_blue_dark</item>
        <item name="colorOnTertiaryContainer">@color/white</item>

        <!-- Controlli e accenti UI -->
        <item name="android:colorControlActivated">@color/parking_blue_light</item>
        <item name="android:colorAccent">@color/parking_blue_light</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/parking_blue_dark</item>

        <!-- Testi secondari e outline -->
        <item name="colorOutline">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="Theme.ParkingMate" parent="Base.Theme.ParkingMate" />
</resources>