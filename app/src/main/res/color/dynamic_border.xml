<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Quando ci clicchi o ci scrivi dentro: BLU CHIARO -->
    <item android:color="@color/parking_blue_light" android:state_focused="true" />
    <item android:color="@color/parking_blue_light" android:state_checked="true" />
    <item android:color="@color/parking_blue_light" android:state_pressed="true" />

    <!-- Di base (quando è deselezionato): BIANCO -->
    <item android:color="@color/white" />
</selector>